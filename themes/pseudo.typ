#let default = (
  coloring-follow-numbering: true,
  default-stroke-length: 1pt,
  line-reference: it => ", line " + str(it),
  algorithm-figure: true,
  frame: (
    breakable: true,
    fill: none,
    height: auto,
    radius: (:),
    stroke: (top: black, bottom: black),
    width: auto,
  ),
  header: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: (y: .4em),
    repeat: false,
    sep: auto,
  ),
  footer: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: (y: .4em),
    repeat: false,
    sep: auto,
  ),
  numbering: (
    format: "1:",
    start: 1,
    end: none,
    fill: auto,
    color: auto,
    inset: .25em,
    alignment: right,
    sep: none,
  ),
  code: (
    fill: none,
    inset: (x: .25em),
    line-spacing: .65em,
    indentation: none,
    indent-size: 1.5em,
    style: none,
  ),
)
