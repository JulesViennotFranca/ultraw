#let default = (
  general: (
    coloring-follow-number: true,
    default-stroke-thickness: 1pt,
    line-reference: it => ", line " + str(it),
    algorithm-figure: true,
  ),
  frame: (
    breakable: true,
    fill: none,
    height: auto,
    radius: (:),
    stroke: (top: black, bottom: black),
    width: auto,
  ),
  header: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: (y: .4em),
    repeat: false,
    sep: auto,
  ),
  footer: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: (y: .4em),
    repeat: false,
    sep: auto,
  ),
  number: (
    format: "1:",
    start: 1,
    end: none,
    color: none,
    fill: auto,
    inset: .25em,
    alignment: right,
    sep: none,
  ),
  code: (
    inset: (x: .25em),
    line-spacing: .65em,
    indentation: none,
    indent-size: 1.5em,
    style: none,
    fill: none,
  ),
)
