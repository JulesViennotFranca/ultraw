#import "../themes/highlights.typ" as hl-style

#let default = (
  coloring-follow-numbering: true,
  default-stroke-length: .05em,
  line-reference: it => ", line " + str(it),
  frame: (
    breakable: true,
    fill: none,
    height: auto,
    radius: (:),
    stroke: none,
    width: auto,
  ),
  header: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: .4em,
    repeat: false,
    sep: auto,
  ),
  footer: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: .4em,
    repeat: false,
    sep: auto,
  ),
  numbering: (
    format: auto,
    start: 1,
    end: none,
    fill: auto,
    color: auto,
    inset: auto,
    alignment: right,
    sep: none,
  ),
  code: (
    fill: none,
    inset: (x: .3em),
    line-spacing: .65em,
    indentation: .05em + gray,
    indent-size: auto,
  ),
  comment: (
    in-code: false,
    indented: false,
    marker: none,
    fill: luma(245),
    style: text.with(style: "italic"),
  ),
  jump: (
    comment: none,
    comment-in-code: true,
    comment-indented: false,
    comment-marker: none,
    comment-fill: none,
    comment-style: auto,
  ),
  lang-tag: (
    format: auto,
    name: none,
    size: 0.8em,
    icon: none,
    fill: luma(230),
    radius: .3em,
    stroke: none,
    mode: "full",
    code-spacing: .5em,
    placement: "code",
  ),
  highlights: (
    default: hl-style.default(),
    alert: hl-style.alert(),
  ),
  // Settings specific to diffs
  diff: (
    line-reference: (k, version) => ", " + version + " line " + str(k),
    columns: (auto, auto),
    column-gutter: 0pt,
    no-diff-marker: [],
    blank-fill: tiling(size: (4pt, 4pt), line(
      start: (0pt, 4pt),
      end: (4pt, 0pt),
      stroke: .3pt + luma(180),
    )),
    sep: .05em + gray,
    markers: (
      visible: true,
      inset: auto,
      sep: none,
    ),
    old: (
      marker: text(red.darken(20%))[-],
      number-color: auto,
      number-fill: rgb("#FF8B85"),
      fill: red.lighten(75%),
    ),
    new: (
      marker: text(olive)[+],
      number-color: auto,
      number-fill: rgb("#7CCBA7"),
      fill: rgb("#32C04C").lighten(75%),
    ),
  ),
)
