#import "../themes/highlights.typ" as hl-style

#let default = (
  general: (
    coloring-follow-number: true,
    default-stroke-thickness: .05em,
    line-reference: it => ", line " + str(it),
    marker-over-number: false,
  ),
  frame: (
    breakable: true,
    fill: none,
    height: auto,
    radius: (:),
    stroke: none,
    width: auto,
  ),
  header: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: .5em,
    repeat: false,
    sep: auto,
  ),
  footer: (
    alignment: left + horizon,
    code-aligned: false,
    fill: none,
    height: auto,
    inset: .5em,
    repeat: false,
    sep: auto,
  ),
  number: (
    format: auto,
    start: 1,
    end: none,
    color: none,
    fill: auto,
    inset: auto,
    alignment: right,
    sep: none,
  ),
  code: (
    inset: (x: .3em),
    line-spacing: .65em,
    indentation: gray,
    fill: none,
  ),
  comment: (
    indent: "frame",
    marker: none,
    marker-fill: auto,
    placement: "number",
    fill: luma(245),
    style: text.with(style: "italic"),
  ),
  jump: (
    comment: none,
    comment-indent: "frame",
    comment-marker: none,
    comment-marker-fill: auto,
    comment-placement: "number",
    comment-fill: none,
    comment-style: auto,
  ),
  highlight: (
    expand: center,
    sticky: auto,
    radius: 0mm,
    fill: none,
    stroke: none,
    code-style: it => it,
  ),
  lang-tag: (
    format: auto,
    name: none,
    size: 0.8em,
    icon: none,
    fill: luma(230),
    radius: .3em,
    stroke: none,
    mode: "full",
    code-spacing: .5em,
    placement: "code",
  ),
  highlights: (
    default: hl-style.default(),
    alert: hl-style.alert(),
  ),
  // Settings specific to diffs
  diff: (
    general: (
      line-reference: (k, version) => ", " + version + " line " + str(k),
      columns: (auto, auto),
      column-gutter: 0pt,
      no-diff-marker: [],
      blank-fill: tiling(size: (4pt, 4pt), line(
        start: (0pt, 4pt),
        end: (4pt, 0pt),
        stroke: .3pt + luma(200),
      )),
      sep: .05em + gray,
    ),
    markers: (
      visible: true,
      inset: auto,
      sep: none,
    ),
    old: (
      marker: text(red.darken(20%))[-],
      number-color: auto,
      number-fill: rgb("#FF8B85"),
      fill: red.lighten(75%),
    ),
    new: (
      marker: text(olive)[+],
      number-color: auto,
      number-fill: rgb("#7CCBA7"),
      fill: rgb("#32C04C").lighten(75%),
    ),
  ),
)
