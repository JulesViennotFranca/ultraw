#import "../styling/highlights.typ" as hl-style
#import "code.typ": *

// -----------------------------------------------------------------------------
// Default
// -----------------------------------------------------------------------------

#let pre-default = (
  general: (
    coloring-follow-numbers: true,
    default-stroke-thickness: .5pt,
    line-reference: it => ", line " + str(it),
    markers-over-numbers: false,
  ),
  frame: (
    breakable: true,
    sharp-page-break: true,
    fill: none,
    height: auto,
    radius: 1mm,
    stroke: none,
    width: auto,
  ),
  header: (
    align: left + horizon,
    code-aligned: false,
    color: auto,
    fill: none,
    height: auto,
    inset: 5pt,
    repeat: false,
    sep: auto,
  ),
  footer: (
    align: left + horizon,
    code-aligned: false,
    color: auto,
    fill: none,
    height: auto,
    inset: 5pt,
    repeat: false,
    sep: auto,
  ),
  numbers: (
    format: auto,
    start: auto,
    end: none,
    color: auto,
    fill: auto,
    inset: auto,
    align: top + right,
    sep: none,
  ),
  code: (
    inset: (x: 3pt),
    line-spacing: .65em,
    indentation: gray,
    indent-size: auto,
    indented-line-return: true,
    theme: auto,
    color: auto,
    fill: none,
  ),
  comment: (
    indent: "frame",
    marker: none,
    marker-fill: auto,
    placement: "numbers",
    fill: luma(245),
    style: text.with(style: "italic"),
    sep: none,
  ),
  jump: (
    skip-lines: false,
    comment: none,
    comment-indent: "frame",
    comment-marker: none,
    comment-marker-fill: auto,
    comment-placement: "numbers",
    comment-fill: none,
    comment-style: auto,
    comment-sep: auto,
  ),
  highlight: (
    expand: center,
    sticky: auto,
    radius: 1mm,
    fill: none,
    stroke: none,
    code-style: it => it,
  ),
  lang-tag: (
    visible: true,
    color: auto,
    name: none,
    size: 0.8em,
    icon: none,
    fill: luma(230),
    radius: .2em,
    stroke: none,
    mode: "full",
    code-spacing: 5pt,
    placement: "code",
  ),
  highlights: (
    default: hl-style.default(),
    alert: hl-style.alert(),
  ),
  diff: (
    general: (
      line-reference: (k, version) => ", " + version + " line " + str(k),
      columns: (auto, auto),
      column-gutter: 0pt,
      blank-fill: tiling(size: (4pt, 4pt), line(
        start: (0pt, 4pt),
        end: (4pt, 0pt),
        stroke: .3pt + luma(200),
      )),
      sep: gray,
    ),
    diff-marker: (
      visible: true,
      inset: auto,
      unchanged: [],
    ),
    old: (
      diff-marker: text(red.darken(20%))[-],
      numbers-color: auto,
      numbers-fill: rgb("#FF8B85"),
      fill: red.lighten(75%),
    ),
    new: (
      diff-marker: text(olive)[+],
      numbers-color: auto,
      numbers-fill: rgb("#7CCBA7"),
      fill: rgb("#32C04C").lighten(75%),
    ),
  ),
)

